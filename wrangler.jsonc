{
  // One Worker: relay (relay.<domain>, ?url=, /ws/binance, /health) + static website (./site) on every other host.
  "name": "qv-relay",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
